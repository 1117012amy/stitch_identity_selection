<button class="bg-white text-[#1a1a1a] hover:bg-[#0055ff] hover:text-white border-2 border-[#1a1a1a] shadow-[2px_2px_0px_#1a1a1a] px-3 py-1 font-headline font-black text-[11px] whitespace-nowrap transition-colors">
