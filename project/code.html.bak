  </style></head><body class="bg-[#f5f0e8] text-[#1a1a1a] font-body min-h-screen flex flex-col selection:bg-[#ff3f3f] selection:text-white"><!-- Top App Header --><header class="fixed top-0 w-full z-50 pt-safe bg-[#f5f0e8]/95 backdrop-blur-md border-b-4 border-[#1a1a1a]"><div class="h-14 px-4 flex items-center justify-between"><div class="flex items-center gap-2"><button aria-label="開啟選單" class="w-10 h-10 flex items-center justify-center text-[#1a1a1a] hover:bg-[#ffcc00] border-2 border-[#1a1a1a] shadow-[2px_2px_0px_#1a1a1a] active:translate-x-0.5 active:translate-y-0.5 transition-all bg-white" type="button"><span class="material-symbols-outlined text-[22px]">menu</span></button><div class="flex items-center gap-1.5 ml-1"><span class="font-headline font-black text-xl tracking-tighter text-[#1a1a1a]">OBSCURE</span><span class="bg-[#ff3f3f] text-white text-[10px] font-headline font-black px-1.5 py-0.5 tracking-widest border border-[#1a1a1a]">BENTO.V4</span></div></div><div class="flex items-center gap-2"><button aria-label="篩選" class="w-10 h-10 flex items-center justify-center text-[#1a1a1a] bg-[#ffcc00] border-2 border-[#1a1a1a] shadow-[2px_2px_0px_#1a1a1a] active:translate-x-0.5 active:translate-y-0.5 transition-all" type="button"><span class="material-symbols-outlined text-[20px]">tune</span></button><div class="w-10 h-10 border-2 border-[#1a1a1a] bg-[#1a1a1a] text-white flex items-center justify-center shadow-[2px_2px_0px_#1a1a1a]"><span class="material-symbols-outlined text-[20px]">person</span></div></div></div></header><main class="flex-1 flex flex-col relative w-full pt-18 pb-28 px-3 sm:px-4"><div class="flex flex-col w-full space-y-4 pt-1">
<!-- 1. Top Asymmetric Bento Box Header -->
<section class="grid grid-cols-12 gap-2.5 w-full">
<!-- Left Bento: 7 cols - Yellow Large Featured Block -->
